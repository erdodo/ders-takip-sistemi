# ─── Docker ortamı için .env şablonu ──────────────────────────────────────────
# Bu dosyayı kopyalayın: cp .env.docker .env.production
# Sonra kendi değerlerinizi girin.

# PostgreSQL şifresi (db container'ında kullanılır)
POSTGRES_PASSWORD=guclu-bir-sifre-girin

# Uygulama portu (host tarafında açılacak port)
APP_PORT=3000

# NextAuth gizli anahtarı — ÜRETİM'de mutlaka değiştirin!
# Üretmek için: openssl rand -base64 32
NEXTAUTH_SECRET=

# Uygulamanın public URL'i (domain veya IP)
NEXTAUTH_URL=http://localhost:3000

# Demo verileri otomatik yükle (ilk kurulumda true yapın, sonra false)
SEED_DB=false
