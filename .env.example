# Veritabanı - PostgreSQL connection string
# Yerel: postgresql://USER:PASSWORD@localhost:5432/ders_takip
# Neon/Supabase gibi cloud: postgresql://...
DATABASE_URL="postgresql://postgres:password@localhost:5432/ders_takip"

# NextAuth.js
# Üretim için: openssl rand -base64 32
NEXTAUTH_SECRET="supersecret-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Opsiyonel: Uygulama URL'si
NEXT_PUBLIC_APP_URL="http://localhost:3000"
