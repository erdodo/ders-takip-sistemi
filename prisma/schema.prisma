// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────

enum Role {
  OWNER
  INSTRUCTOR
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
}

enum LessonType {
  YOGA
  PILATES
  PRIVATE
  OTHER
}

// ─── NextAuth Modelleri ──────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Ana Modeller ────────────────────────────────────────

/// Stüdyo - Her SaaS müşterisi bir stüdyo
model Studio {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  phone        String?
  email        String?
  address      String?
  website      String?
  logoUrl      String?
  primaryColor String?  @default("#16a34a")
  accentColor  String?  @default("#15803d")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users            User[]
  customers        Customer[]
  packages         Package[]
  payments         Payment[]
  webhookEndpoints WebhookEndpoint[]
}

/// Webhook endpoint tanımı
model WebhookEndpoint {
  id        String   @id @default(cuid())
  studioId  String
  url       String
  secret    String   // HMAC-SHA256 imzalamak için
  events    String[] // ["lesson.processed","payment.created",...]
  isActive  Boolean  @default(true)
  label     String?  // Açıklama etiketi
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studio Studio       @relation(fields: [studioId], references: [id], onDelete: Cascade)
  logs   WebhookLog[]
}

/// Webhook teslimat logu
model WebhookLog {
  id         String   @id @default(cuid())
  endpointId String
  event      String
  payload    String   @db.Text // JSON string
  status     String   // "success" | "failed" | "pending"
  statusCode Int?
  error      String?
  sentAt     DateTime @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
}

/// Stüdyo personeli (Owner / Instructor)
model User {
  id            String    @id @default(cuid())
  studioId      String
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  role          Role      @default(INSTRUCTOR)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  studio        Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)
  accounts      Account[]
  sessions      Session[]
  lessonsLogged Lesson[]  @relation("LoggedBy")
}

/// Stüdyonun üyesi / müşterisi
model Customer {
  id        String   @id @default(cuid())
  studioId  String
  name      String
  email     String?
  phone     String   // WhatsApp numarası (TR: 5xx...)
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studio           Studio            @relation(fields: [studioId], references: [id], onDelete: Cascade)
  customerPackages CustomerPackage[]
  payments         Payment[]
}

/// Paket şablonu - stüdyo tarafından tanımlanan satılabilir paketler
model Package {
  id           String     @id @default(cuid())
  studioId     String
  name         String     // "10 Ders Yoga", "Aylık Pilates"
  lessonType   LessonType @default(YOGA)
  lessonCount  Int        // Toplam ders hakkı
  validityDays Int        // Kaç gün geçerli (örn: 30)
  price        Decimal    @db.Decimal(10, 2)
  description  String?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  studio           Studio            @relation(fields: [studioId], references: [id], onDelete: Cascade)
  customerPackages CustomerPackage[]
}

/// Müşteriye atanmış aktif paket (kontör sistemi)
model CustomerPackage {
  id               String   @id @default(cuid())
  customerId       String
  packageId        String
  totalCredits     Int      // Başlangıç ders hakkı (package.lessonCount kopyası)
  remainingCredits Int      // Her ders işlemede 1 azalır
  startDate        DateTime @default(now())
  expiresAt        DateTime // startDate + validityDays
  isPaid           Boolean  @default(false)
  isActive         Boolean  @default(true)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  package  Package   @relation(fields: [packageId], references: [id])
  lessons  Lesson[]
  payments Payment[]
}

/// Ders geçmişi - her "Ders İşle" tıklamasında 1 kayıt
model Lesson {
  id                String   @id @default(cuid())
  customerPackageId String
  loggedById        String
  lessonDate        DateTime @default(now())
  notes             String?
  createdAt         DateTime @default(now())

  customerPackage CustomerPackage @relation(fields: [customerPackageId], references: [id], onDelete: Cascade)
  loggedBy        User            @relation("LoggedBy", fields: [loggedById], references: [id])
}

/// Ödemeler
model Payment {
  id                String        @id @default(cuid())
  studioId          String
  customerId        String
  customerPackageId String?
  amount            Decimal       @db.Decimal(10, 2)
  method            PaymentMethod @default(CASH)
  paidAt            DateTime      @default(now())
  notes             String?
  createdAt         DateTime      @default(now())

  studio          Studio           @relation(fields: [studioId], references: [id], onDelete: Cascade)
  customer        Customer         @relation(fields: [customerId], references: [id])
  customerPackage CustomerPackage? @relation(fields: [customerPackageId], references: [id])
}
